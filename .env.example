# API Keys (REQUIRED)
ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENAI_API_KEY=sk-your-key-here

# ACRCloud Viral Sound Detection (OPTIONAL - for enhanced audio analysis)
# Sign up at https://www.acrcloud.com/ to get credentials
ACRCLOUD_ACCESS_KEY=your_acrcloud_access_key
ACRCLOUD_ACCESS_SECRET=your_acrcloud_secret

# Cache Settings
CACHE_DIR=./cache
USE_CACHE=true
CACHE_EXPIRY_HOURS=24
MAX_CACHE_SIZE_GB=1.0

# Database Settings
DB_PATH=./data/predictions.db

# Processing Settings
MAX_PARALLEL_WORKERS=2
DEFAULT_FRAMES_PER_MINUTE=24
DEFAULT_MAX_FRAMES=60

# Application Settings
FLASK_ENV=production
DEBUG=false
